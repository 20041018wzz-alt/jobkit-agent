# jobkit-agent 环境变量示例：复制为 .env 生效（不填也能跑，自动进入 Mock 模式）

# ── LLM（OpenAI 兼容：DeepSeek / 通义 / 本地 vLLM 均可） ──
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
# 强制使用离线 Mock（1/true/yes 开启），不配 API Key 时自动为 true
LLM_MOCK=

# ── 检索 ──
TOP_K=4
# 主分（IDF 覆盖率）阈值：低于它视为"知识库里没有相关内容"
RELEVANCE_THRESHOLD=0.35
# 缺失清单条目的胜出比例：达到最强证据的 70% 就按"没有记录"处理（宁可拒答，不可编造）
GAP_DOMINANCE_RATIO=0.7

# ── Agent 行为 ──
MAX_TOOL_STEPS=3
MAX_HISTORY=10

# ── 服务 ──
HOST=0.0.0.0
PORT=8100
LOG_LEVEL=INFO

# ── 知识库与评测集（不填则自动：data/knowledge.local 优先，否则用示例 data/knowledge） ──
# JOBKIT_KNOWLEDGE_DIR=./data/knowledge.local
# JOBKIT_EVAL_SET=./data/eval_set.local.json
